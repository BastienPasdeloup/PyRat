##########################################################################################
########################################## INFO ##########################################
##########################################################################################

# This file lists the files and directories that Git should not version in the PyRat repository.
# It covers what PyRat produces: the environment and the files generated by Python,
# the build of the package and of the documentation.
# It also covers what a machine adds on its own: the settings of an editor, and the files created by an operating system.

##########################################################################################
######################################## CONTENTS ########################################
##########################################################################################

# Virtual environment, created by uv on each machine
.venv/

# Files generated by Python when running the code
__pycache__/
*.py[cod]

# Files generated when building the package
build/
dist/
*.egg-info/
pyrat_game-*/

# Build of the documentation, generated by "make -C docs html"
docs/build/

# Lock file of uv, not versioned here since PyRat is a library
uv.lock

# Settings of an editor, which describe one machine rather than the project
.vscode/
.idea/

# Files created by macOS
.DS_Store

# Files created by Windows, and by OneDrive when it synchronizes a directory
Thumbs.db
ehthumbs.db
desktop.ini

##########################################################################################
##########################################################################################
